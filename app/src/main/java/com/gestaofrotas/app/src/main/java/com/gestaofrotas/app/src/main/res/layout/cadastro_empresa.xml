<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏢 Cadastro da Empresa"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"
        android:background="#2E7D32"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <EditText android:id="@+id/campo_cnpj" android:hint="CNPJ" android:inputType="number"
        android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/campo_razao_social" android:hint="Razão Social"
        android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/campo_responsavel" android:hint="Nome do Responsável"
        android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/campo_telefone" android:hint="Telefone / WhatsApp" android:inputType="phone"
        android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/campo_email_empresa" android:hint="E-mail da Empresa" android:inputType="textEmailAddress"
        android:padding="14dp" android:background="#FFFFFF" android:layout_marginBottom="20dp"/>

    <Button android:id="@+id/botao_salvar_cadastro" android:text="SALVAR CADASTRO"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="#2E7D32" android:textColor="#FFFFFF" android:textSize="16sp"/>

</LinearLayout>
