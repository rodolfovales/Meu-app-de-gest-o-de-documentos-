<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF"
    android:layout_marginVertical="4dp"
    android:elevation="2dp">

    <TextView android:id="@+id/item_nome" android:textSize="17sp" android:textStyle="bold"
        android:textColor="#1976D2"/>
    <TextView android:id="@+id/item_cnpj" android:textSize="13sp" android:textColor="#666666"
        android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/item_status" android:textSize="13sp" android:textColor="#2E7D32"
        android:layout_marginTop="4dp"/>

</LinearLayout>
