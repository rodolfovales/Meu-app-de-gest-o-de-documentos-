<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestão de Documentos"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Combustível para Frotas"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btn_empresa"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📋 Sou Empresa - Enviar Documentos"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_master"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔐 Acesso Master - Ver Documentos"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

</LinearLayout>
